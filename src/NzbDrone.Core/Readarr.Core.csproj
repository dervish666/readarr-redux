<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Diacritical.Net" />
    <PackageReference Include="LazyCache" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Servarr.FluentMigrator.Runner" />
    <PackageReference Include="Servarr.FluentMigrator.Runner.SQLite" />
    <PackageReference Include="Servarr.FluentMigrator.Runner.Postgres" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Targets.Syslog" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="RestSharp" />
    <PackageReference Include="System.IO.Abstractions" />
    <PackageReference Include="TagLibSharp-Lidarr" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Equ" />
    <PackageReference Include="MonoTorrent" />
    <PackageReference Include="PdfSharpCore" />
  </ItemGroup>
  <!--
    Servarr.FluentMigrator.Runner drags in every database runner. Readarr only uses SQLite and Postgres, but
    the SQL Server and SQL Server CE runners bring vulnerable packages (IdentityModel 6.8.0 through
    Microsoft.Data.SqlClient 2.1.7, System.Drawing.Common 4.7.0 through System.Security.Permissions 4.7.0).
    These pin patched versions. Drop them along with the vendored FluentMigrator.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Permissions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NzbDrone.Common\Readarr.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Localization\Core\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\Logo\64.png">
      <Link>Resources\Logo\64.png</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="Books\Calibre\Languages\2to3.json" />
    <EmbeddedResource Include="Books\Calibre\Languages\by3.json" />
    <EmbeddedResource Include="Books\Calibre\Languages\name_map.json" />
  </ItemGroup>
</Project>
