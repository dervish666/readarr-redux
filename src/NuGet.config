<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Packages that only ever existed on Servarr's Azure feeds, vendored at the pinned versions. See Libraries/nuget/README.md -->
    <add key="vendored" value="Libraries/nuget" />
  </packageSources>
  <packageSourceMapping>
  <!-- key value for <packageSource> should match key values from <packageSources> element -->
  <packageSource key="nuget.org">
    <package pattern="*" />
  </packageSource>
  <packageSource key="vendored">
    <package pattern="Servarr.FluentMigrator*" />
    <package pattern="System.Data.SQLite.Core.Servarr" />
    <package pattern="Mono.Posix.NETStandard" />
    <package pattern="coverlet.collector" />
    <package pattern="coverlet.core" />
  </packageSource>
</packageSourceMapping>
</configuration>
